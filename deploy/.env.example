# 服务器环境变量配置（放到 /opt/jubensha/.env）
# 把下面三处的值替换成你本机 .env 里的真实值，别提交到 git

# 火山引擎 TTS（语音合成）
VOLCANO_TTS_APP_ID=你的APP_ID
VOLCANO_TTS_TOKEN=你的Token
VOLCANO_TTS_VOICE=zh_male_shaonianzixin_moon_bigtts

# DeepSeek AI（剧本 / 对话生成）
DEEPSEEK_API_KEY=你的DeepSeek_API_Key

# 公网联机地址（可选，仅用于控制台显示与独立 TCP 客户端；网页走同源无需改）
GAME_PUBLIC_IP=150.158.11.253
GAME_PUBLIC_PORT=8888
GAME_HTTP_URL=https://ylxq.art
