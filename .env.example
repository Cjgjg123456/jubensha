# ====================
# 环境变量配置模板
# 复制为 .env 并填入真实值，不要提交 .env 到 Git！
# ====================

# 火山引擎 TTS（语音合成）
VOLCANO_TTS_APP_ID=你的AppID
VOLCANO_TTS_TOKEN=你的AccessToken
VOLCANO_TTS_VOICE=zh_male_linjiananhai_moon_bigtts

# DeepSeek AI（文字生成）
DEEPSEEK_API_KEY=sk-你的DeepSeek密钥

# 联机服务器公网地址（可选，本地开发不需要）
GAME_PUBLIC_IP=你的公网IP
GAME_PUBLIC_PORT=14220
GAME_HTTP_URL=http://你的公网URL
